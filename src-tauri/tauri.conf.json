{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Soundwave",
  "version": "../package.json",
  "identifier": "io.github.davidniessen.soundwave",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Soundwave",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "visible": false,
        "minWidth": 960,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "icons/soundwave-file.ico": "soundwave-file.ico"
    },
    "fileAssociations": [
      {
        "ext": ["soundwave"],
        "name": "Soundwave.Song",
        "description": "Soundwave song",
        "mimeType": "application/x-soundwave",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/file-icon.wxs"],
        "componentRefs": ["SoundwaveSongFileIcon"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["soundwave"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBRTAwNjg3RUFDRDMzMUIKUldRYk04M3Fod2JnS29ENURZNTNqMC80NXRmNncxbHN6bEU2d0V3b0xjWm4vOGVoV0lCeFo3eGEK",
      "endpoints": ["https://github.com/DavidNiessen/soundwave/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
