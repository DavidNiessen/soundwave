# The server's image (server/Dockerfile) needs only the server, the protocol it shares with the
# game, the game's judging, which it checks scores with, and the .soundwave file format, which it
# reads shared songs with.
*
!server/package.json
!server/src
!src/net/protocol.ts
!src/net/similarity.ts
!src/chart/types.ts
!src/game/GameSession.ts
!src/game/judge.ts
!src/game/scoring.ts
!src/game/replay.ts
!src/storage/soundwaveFile.ts
